@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(robot_core CONFIG REQUIRED)
if(@BUILD_WITH_OPENMP@)
  find_dependency(OpenMP REQUIRED COMPONENTS CXX)
endif()
if(small_gicp_FIND_COMPONENTS)
  set(small_gicp_FOUND FALSE)
  set(small_gicp_NOT_FOUND_MESSAGE "This package exports native small_gicp::small_gicp and small_gicp::sc_self_fit targets; components are not supported.")
  return()
endif()
if(NOT TARGET small_gicp::small_gicp)
  include("${CMAKE_CURRENT_LIST_DIR}/small_gicp-targets.cmake")
endif()
check_required_components(small_gicp)
