# Config file for the small_gicp package
#
# Usage from an external project:
#
#  find_package(small_gicp REQUIRED)
#  target_link_libraries(MY_TARGET_NAME small_gicp::small_gicp)
#
# Optionally, for TBB support in *_tbb.hpp headers also add:
#
#  find_package(TBB REQUIRED)
#  target_link_libraries(MY_TARGET_NAME TBB::tbb TBB::tbbmalloc)
#
@PACKAGE_INIT@

# A later find_package may request an optional component after a native import.
# Save this path before dependencies evaluate their own PACKAGE_INIT blocks.
set_and_check(small_gicp_INTEROP_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@/small_gicp_interop")

set(BUILD_WITH_OPENMP @BUILD_WITH_OPENMP@)

include(CMakeFindDependencyMacro)
find_dependency(slam_math CONFIG REQUIRED)
if (BUILD_WITH_OPENMP)
  find_dependency(OpenMP REQUIRED COMPONENTS CXX)
endif()

# For FindTBB.cmake
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

if(NOT TARGET small_gicp::small_gicp)
  include("${CMAKE_CURRENT_LIST_DIR}/small_gicp-targets.cmake")
endif()

foreach(_small_gicp_component IN LISTS small_gicp_FIND_COMPONENTS)
  set(small_gicp_${_small_gicp_component}_FOUND FALSE)
  if(_small_gicp_component STREQUAL "eigen" OR
     _small_gicp_component STREQUAL "pcl" OR
     _small_gicp_component STREQUAL "benchmark")
    # Optional components must not make a native import require these packages.
    find_package(Eigen3 CONFIG QUIET)
    if(NOT Eigen3_FOUND)
      set(small_gicp_NOT_FOUND_MESSAGE "Component ${_small_gicp_component} requires Eigen3")
      continue()
    endif()
    if(_small_gicp_component STREQUAL "pcl")
      find_package(PCL QUIET COMPONENTS common filters io registration)
      if(NOT PCL_FOUND)
        set(small_gicp_NOT_FOUND_MESSAGE "Component pcl requires PCL common/filters/io/registration")
        continue()
      endif()
    elseif(_small_gicp_component STREQUAL "benchmark")
      find_package(fmt CONFIG QUIET)
      if(NOT fmt_FOUND)
        set(small_gicp_NOT_FOUND_MESSAGE "Component benchmark requires fmt")
        continue()
      endif()
    endif()
    if(NOT TARGET small_gicp::${_small_gicp_component})
      add_library(small_gicp::${_small_gicp_component} INTERFACE IMPORTED)
      set_target_properties(small_gicp::${_small_gicp_component} PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${small_gicp_INTEROP_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES "small_gicp::small_gicp;Eigen3::Eigen")
      if(_small_gicp_component STREQUAL "pcl")
        set_property(TARGET small_gicp::pcl APPEND PROPERTY
          INTERFACE_INCLUDE_DIRECTORIES "${PCL_INCLUDE_DIRS}")
        set_property(TARGET small_gicp::pcl APPEND PROPERTY
          INTERFACE_LINK_LIBRARIES "${PCL_LIBRARIES}")
        set_property(TARGET small_gicp::pcl APPEND PROPERTY
          INTERFACE_COMPILE_OPTIONS "${PCL_DEFINITIONS}")
      elseif(_small_gicp_component STREQUAL "benchmark")
        set_property(TARGET small_gicp::benchmark APPEND PROPERTY
          INTERFACE_LINK_LIBRARIES fmt::fmt)
      endif()
    endif()
    set(small_gicp_${_small_gicp_component}_FOUND TRUE)
  else()
    set(small_gicp_NOT_FOUND_MESSAGE "Unsupported small_gicp component: ${_small_gicp_component}")
  endif()
endforeach()
check_required_components(small_gicp)
